{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "soma",
	"main": "src/main.js",
	"compatibility_date": "2026-07-06",
	// AsyncLocalStorage: the usage meter attributes each D1 result to its request.
	"compatibility_flags": ["nodejs_als"],
	"workers_dev": true,
	"observability": { "enabled": true },
	// No Smart Placement: it moved the hub to KIX (Osaka) and tripled every request; the D1 primary is ENAM, next to the callers.
	// The hub's storage. Declaring the bindings here IS the provisioning —
	// nothing about D1 or R2 reaches the client.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "soma",
			"database_id": "4245f13e-535b-4db5-a591-646f597231c8"
		},
		{
			"binding": "AUTH_DB",
			"database_name": "soma-auth",
			"database_id": "235cc853-6652-432c-ae41-0e75daea3f38"
		}
	],
	// Instant sync: one ChangeSignal object per hub holds the change sequence
	// replicas long-poll at /v1/changes (src/changes.js). SQLite-backed, so
	// it deploys on any Workers plan.
	"durable_objects": { "bindings": [{ "name": "CHANGES", "class_name": "ChangeSignal" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChangeSignal"] }],
	"r2_buckets": [
		{ "binding": "BACKUPS", "bucket_name": "soma-backups" },
		{ "binding": "ARCHIVE", "bucket_name": "soma-archive" }
	],
	// Pipelines stream: appends tee events here → Iceberg table soma.events
	// in the R2 Data Catalog (managed compaction on). Landing stays the raw
	// source of truth.
	"pipelines": [{ "stream": "1d761b6cb98c423dbd6f59c3760a1fb0", "binding": "EVENTS" }],
	"vars": {
		"ACCOUNT_ID": "1e69de15e5dc3dddea6db7b3ae8087bc",
		"ARCHIVE_BUCKET": "soma-archive",
		"LOGIN_ACCESS_AUD": "9f21efcb47f8b63e252f64e20c3df14a9e7372999de4bb1ed6a84599c46f9f29",
		// What the backup cron exports through D1's export API (src/backup.js):
		// backup object name -> database_id of a d1_databases entry above.
		"BACKUP_DATABASES": {
			"soma": "4245f13e-535b-4db5-a591-646f597231c8",
			"auth": "235cc853-6652-432c-ae41-0e75daea3f38"
		},
		// The one entry whose copies consumers may list, download and take
		// (src/backups.js); the auth registry's never leave the service.
		"BACKUP_DATA_DATABASE": "soma"
	},
	// Daily at 09:10 UTC; the Worker decides which retention prefixes today
	// belongs to (daily / weekly / monthly / yearly). Every 15 minutes the
	// derivation sweep picks up underived and stale rows (SWEEP_CRON in
	// src/index.js must match).
	"triggers": { "crons": ["10 9 * * *", "*/15 * * * *"] }
}
